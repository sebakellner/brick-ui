{
  "name": "brick-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brick — a small web components kit built with Lit and TypeScript",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:tokens": "style-dictionary build --config style-dictionary.config.mjs",
    "check:tokens": "node scripts/check-token-usage.mjs",
    "typecheck": "tsc --noEmit",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@storybook/web-components-vite": "^10.6.7",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.0.2",
    "storybook": "^10.6.7",
    "style-dictionary": "^5.8.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
