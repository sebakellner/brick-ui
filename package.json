{
  "name": "brikka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Brikka \u2014 a small web components kit built with Lit and TypeScript",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build:tokens": "style-dictionary build --config packages/tokens/style-dictionary.config.mjs",
    "build:llms": "node scripts/build-llms-index.mjs",
    "build:manifest": "cem analyze --config custom-elements-manifest.config.mjs && node scripts/normalize-manifest.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "check:tokens": "node scripts/check-token-usage.mjs",
    "check:llms": "node scripts/build-llms-index.mjs --check",
    "check:readmes": "node scripts/check-readmes.mjs",
    "check:artifacts": "node scripts/check-artifacts.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "test:checks": "node --test \"scripts/*.test.mjs\"",
    "storybook": "pnpm --filter @brikka-ui/storybook-web-components storybook",
    "build-storybook": "pnpm --filter @brikka-ui/storybook-web-components build"
  },
  "dependencies": {
    "@brikka-ui/tokens": "workspace:*",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@brikka-ui/test-utils": "workspace:*",
    "@changesets/cli": "^3.0.3",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@open-wc/testing": "^5.0.0",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-commands": "^1.0.3",
    "@web/test-runner-playwright": "^1.0.2",
    "axe-core": "^4.14.0",
    "playwright": "1.65.1",
    "prettier": "^3.10.1",
    "style-dictionary": "^5.8.0",
    "turbo": "^2.11.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "sideEffects": [
    "**/define.js",
    "**/define.ts"
  ],
  "customElements": "packages/web-components/src/custom-elements.json"
}
