{
  "name": "@brick/styles",
  "version": "0.1.0",
  "private": true,
  "description": "Brick's styles: the token source, the custom properties it generates, and the theme a page loads",
  "type": "module",
  "exports": {
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    ".": {
      "types": "./dist/tokens.generated.d.ts",
      "default": "./dist/tokens.generated.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "types": "./dist/tokens.generated.d.ts"
}
