{
  "name": "@brikka-ui/web-components",
  "version": "0.1.0",
  "description": "Brikka's elements: Lit custom elements with a token-driven theming contract",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebakellner/brikka.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://sebakellner.github.io/brikka/",
  "bugs": "https://github.com/sebakellner/brikka/issues",
  "keywords": [
    "web-components",
    "custom-elements",
    "lit",
    "design-system",
    "components",
    "theming"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register.js": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./components/*/define.js": "./dist/components/*/define.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/define.js",
    "**/define.ts",
    "**/register.js",
    "**/register.ts"
  ],
  "peerDependencies": {
    "@brikka-ui/styles": "workspace:^",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@brikka-ui/test-utils": "workspace:*",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "types": "tsc -p tsconfig.build.json"
  },
  "types": "./dist/index.d.ts"
}
