{
  "font": {
    "$type": "fontFamily",
    "sans": {
      "$value": "ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif"
    }
  },
  "font-size": {
    "$type": "dimension",
    "sm": {
      "$value": "0.8125rem"
    },
    "md": {
      "$value": "0.9375rem"
    }
  },
  "font-weight": {
    "$type": "fontWeight",
    "medium": {
      "$value": "500"
    }
  },
  "line-height": {
    "$type": "number",
    "md": {
      "$value": "1.5"
    }
  }
}
