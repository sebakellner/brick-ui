{
  "name": "@brick/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Brick's design tokens: the JSON, the pipeline that builds it, and the CSS a page loads",
  "type": "module",
  "exports": {
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens/base.css",
    ".": {
      "types": "./dist/tokens.generated.d.ts",
      "default": "./dist/tokens.generated.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "types": "./dist/tokens.generated.d.ts"
}
