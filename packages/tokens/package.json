{
  "name": "@brikka-ui/tokens",
  "version": "0.1.0",
  "description": "Brikka's design system: the token source, the custom properties it generates, and the theme a page loads",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebakellner/brikka.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://sebakellner.github.io/brikka/",
  "bugs": "https://github.com/sebakellner/brikka/issues",
  "keywords": [
    "design-tokens",
    "css-custom-properties",
    "theming",
    "style-dictionary"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./tokens.css": "./src/tokens.css",
    ".": {
      "types": "./dist/tokens.generated.d.ts",
      "default": "./dist/tokens.generated.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "types": "./dist/tokens.generated.d.ts"
}
